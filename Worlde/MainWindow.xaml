<Window x:Class="Worlde.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Worlde"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800" Background="Black">
    <Grid Background="#FF0B0B0B">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="220" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <!--kafelki tekstu-->
        <ItemsControl Grid.Row="0" Grid.Column="0" Width="350" Height="500" ItemsSource="{Binding Tiles}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="6" Columns="5"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Margin="5" BorderThickness="2" BorderBrush="#FFCCCCCC" x:Name="TileBorder" MinHeight="50" MinWidth="50">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#212121"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding State}" Value="Correct">
                                        <Setter Property="Background" Value="Green"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding State}" Value="Present">
                                        <Setter Property="Background" Value="#FFFFA000"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding State}" Value="Absent">
                                        <Setter Property="Background" Value="Black"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Viewbox Stretch="Uniform">
                            <TextBlock Text="{Binding Letter}" FontSize="2" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
                        </Viewbox>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <!--klawiatura 3 rowy bo tak-->
        <StackPanel Grid.Row="1" Grid.Column="0" Margin="10" Orientation="Vertical" HorizontalAlignment="Center">
            <ItemsControl ItemsSource="{Binding KeysRow1}" HorizontalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel HorizontalAlignment="Center"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding Letter}" Margin="5" Width="40" Height="40" Click="KeyButton_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#212121"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding State}" Value="Correct">
                                            <Setter Property="Background" Value="Green"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="Present">
                                            <Setter Property="Background" Value="#FFFFA000"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="Absent">
                                            <Setter Property="Background" Value="Black"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl ItemsSource="{Binding KeysRow2}" HorizontalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel HorizontalAlignment="Center"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding Letter}" Margin="5" Width="40" Height="40" Click="KeyButton_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#212121"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding State}" Value="Correct">
                                            <Setter Property="Background" Value="Green"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="Present">
                                            <Setter Property="Background" Value="#FFFFA000"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="Absent">
                                            <Setter Property="Background" Value="Black"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl ItemsSource="{Binding KeysRow3}" HorizontalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel HorizontalAlignment="Center"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding Letter}" Margin="5" Width="60" Height="40" Click="KeyButton_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#212121"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding State}" Value="Correct">
                                            <Setter Property="Background" Value="Green"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="Present">
                                            <Setter Property="Background" Value="#FFFFA000"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="Absent">
                                            <Setter Property="Background" Value="Black"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- panel debug -->
        <StackPanel Grid.Column="1" Grid.RowSpan="2" Margin="10" >
            <TextBlock Text="Debug" FontWeight="Bold" Foreground="White" Margin="0,0,0,10"/>
            <Button Content="Nowa gra" Click="NewGame_Click" Margin="0,0,0,10" Padding="8,4" Background="#FF2A2A2A" Foreground="White"/>
            <Button Content="Dodaj do listy słów" Click="AddWords_Click" Margin="0,0,0,10" Padding="8,4" Background="#FF2A2A2A" Foreground="White"/>
            <TextBlock Text="Słowo którego niewiesz:" Foreground="LightGray" FontSize="12" Margin="5"/>
            <TextBlock Text="{Binding SecretWord}" Foreground="White" FontSize="16" Margin="5"/>
            <TextBlock Text="Ilość słów:" Foreground="LightGray" FontSize="12" Margin="5"/>
            <TextBlock Text="{Binding WordsCount}" Foreground="White" FontSize="16" Margin="5"/>
        </StackPanel>
    </Grid>
</Window>

